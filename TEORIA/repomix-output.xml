/* ============================================================
   GUÍA DEL AUTOESTOPISTA GALÁCTICO // MARKDOWN -> PDF
   Edición Mark XI - Colores Originales Restaurados
   Diseño de vanguardia 2026 adaptado para impresión estática
   ============================================================ */

/* 1. TIPOGRAFÍA AVANZADA 2026 */
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Outfit:wght@800;900&display=swap');

:root {
    /* Tu paleta de colores original intacta */
    --paper: #f3efd9;
    --paper-light: #fcf9e9;
    --paper-shadow: #e4dfc7;
    --ink: #192b30;
    --ink-soft: #40545a;
    --teal: #167b7a;
    --teal-dark: #10595d;
    --coral: #d45e49;
    --yellow: #e9bd42;
    --sky: #b9ded4;
    --code-bg: #18343a;
    --code-ink: #f3efd9;
   GALACTIC FIELD GUIDE
   Markdown → PDF / VS Code / Chromium Print Engine
   ------------------------------------------------------------
   Visual language:
   Retro-futurist field manual / galactic bureaucracy /
   technical archive / absurd survival documentation.

   Designed for:
   - A4 PDF
   - Chromium-based Markdown → PDF extensions
   - VS Code
   - Long documents
   - Tables / code / images / callouts
   - Predictable page breaks
   ============================================================ */


/* ============================================================
   01. DESIGN TOKENS
   ============================================================ */

:root {
    /* --- PAPER --- */
    --paper: #f4efe2;
    --paper-light: #faf7f0;
    --paper-dark: #e8dfca;

    /* --- INK --- */
    --ink: #111d21;
    --ink-soft: #384d54;
    --ink-faded: #65777b;

    /* --- GALACTIC SIGNAL COLORS --- */
    --teal: #147372;
    --teal-dark: #0a3d3c;
    --teal-light: #b3dacd;

    --coral: #d14935;
    --yellow: #e5b32a;

    /* --- TERMINAL --- */
    --code-bg: #0d1b1e;
    --code-ink: #70f3d4;
    --code-muted: #83a9a5;

    /* --- GRID --- */
    --grid-line: rgba(20, 115, 114, 0.075);

    /* --- DIMENSIONS --- */
    --content-width: 180mm;

    /* --- SHADOW --- */
    --shadow: 3px 3px 0 var(--ink);
}


/* ============================================================
   02. FONT IMPORTS
   ------------------------------------------------------------
   If your VS Code PDF extension blocks external fonts,
   the fallback stack keeps the document readable.
   ============================================================ */

@import url(
    "https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
);


/* ============================================================
   03. GLOBAL BOX MODEL
   ============================================================ */

*,
*::before,
*::after {
    box-sizing: border-box;
}


/* ============================================================
   04. PRINT PAGE
   ------------------------------------------------------------
   Keep @page deliberately conservative.
   Chromium support for advanced margin boxes varies between
   PDF extensions.
   ============================================================ */

@page {
    size: A4;
    margin: 18mm 15mm 20mm 15mm;
}


/* ============================================================
   05. DOCUMENT BASE
   ============================================================ */

html {
    font-size: 10pt;
    background: var(--paper);
}

html, body {
    background-color: var(--paper) !important;
body {
    width: auto;
    max-width: none;

    margin: 0;
    padding: 0;

    color: var(--ink);
    background-color: var(--paper);

    font-family:
        "Space Grotesk",
        "Segoe UI",
        Arial,
        sans-serif;

    font-size: 10pt;
    line-height: 1.55;

    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;

body {
    box-sizing: border-box;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    padding: 18mm 20mm !important;
    font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
    font-size: 10.5pt;
    line-height: 1.62;
    /* 2026 Tech: Evita viudas y huérfanas de forma nativa */
    text-wrap: pretty; 
}

/* ============================================================
   TIPOGRAFÍA Y ENCABEZADOS
   ============================================================ */

strong { color: var(--teal-dark); font-weight: 700; }
em { color: var(--coral); }

h1, h2, h3, h4, h5, h6 {
    position: relative;
    color: var(--ink);
    font-family: "Outfit", "Space Grotesk", sans-serif;
    page-break-after: avoid;
    break-after: avoid;
    /* 2026 Tech: Equilibra automáticamente el texto */
    text-wrap: balance; 
    /*
     * Technical-paper grid.
     * Kept deliberately subtle so it does not dominate
     * printed text.
     */
    background-image:
        linear-gradient(
            var(--grid-line) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            var(--grid-line) 1px,
            transparent 1px
        );

    background-size: 20px 20px;
}


/* ============================================================
   06. TEXT
   ============================================================ */

p {
    margin: 0 0 0.85em;

    text-align: justify;

    /*
     * Chromium supports this reasonably well and it prevents
     * ugly word overflow in justified paragraphs.
     */
    overflow-wrap: break-word;
}

strong {
    color: var(--teal-dark);
    font-weight: 700;
}

em {
    color: var(--coral);
    font-style: italic;
}

a {
    color: var(--teal-dark);
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
}


/* ============================================================
   07. HEADINGS
   ============================================================ */

h1,
h2,
h3,
h4,
h5,
h6 {
    color: var(--ink);

    font-family:
        "Syne",
        "Space Grotesk",
        Arial,
        sans-serif;

    font-weight: 800;

    line-height: 1.15;

    /*
     * Critical for PDF pagination.
     */
    break-after: avoid;
    page-break-after: avoid;

    /*
     * Prevent a heading from being stranded at the
     * bottom of a page.
     */
    break-inside: avoid;
    page-break-inside: avoid;
}


/* ------------------------------------------------------------
   H1 — MAJOR SECTION
   ------------------------------------------------------------ */

h1 {
    margin: 34px 0 24px;
    padding: 16px 20px;
    background: var(--ink);
    color: var(--paper-light);
    font-size: 26pt;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    /* Corte biselado sci-fi usando clip-path */
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%);
    border-left: 8px solid var(--teal);
}

h1::before {
    content: "ENTRADA SEC. // ";
    color: var(--yellow);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.4em;
    vertical-align: middle;
    letter-spacing: 0.1em;
    position: relative;

    margin: 28px 0 18px;
    padding: 11px 14px 12px;

    background: var(--ink);
    color: var(--paper-light);

    border-left: 8px solid var(--yellow);
    border-bottom: 3px solid var(--coral);

    font-size: 24pt;
    letter-spacing: -0.02em;

    text-transform: uppercase;

    /*
     * Avoid clip-path:
     * some PDF engines render it inconsistently.
     */
    box-shadow: 4px 4px 0 var(--teal-dark);
}

h1::before {
    content: "SEC::";

    margin-right: 9px;

    color: var(--coral);

    font-family:
        "Share Tech Mono",
        monospace;

    font-size: 12pt;
    font-weight: 400;
    letter-spacing: 0.03em;
}


/* ------------------------------------------------------------
   H2 — SUBSECTION
   ------------------------------------------------------------ */

h2 {
    margin: 36px 0 16px;
    padding: 8px 12px;
    border-bottom: 2px solid var(--ink);
    font-size: 18pt;
    display: inline-block;
    padding-right: 40px;
}

h2::before {
    content: "►";
    margin-right: 10px;
    color: var(--coral);
    font-size: 0.8em;
}

h3 { margin: 26px 0 10px; color: var(--teal-dark); font-size: 14pt; }
h4 { margin-top: 22px; color: var(--ink-soft); font-size: 11pt; text-transform: uppercase; }

a {
    color: var(--teal-dark);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    margin: 24px 0 12px;
    padding: 7px 10px;

    border-left: 5px solid var(--coral);
    border-bottom: 2px solid var(--teal);

    background:
        linear-gradient(
            90deg,
            rgba(179, 218, 205, 0.65),
            rgba(179, 218, 205, 0)
        );

    font-size: 15pt;

    text-transform: uppercase;
}

h2::before {
    content: "// ";

    color: var(--teal-dark);

    font-family:
        "Share Tech Mono",
        monospace;
}


/* ------------------------------------------------------------
   H3 — FIELD ENTRY
   ------------------------------------------------------------ */

h3 {
    margin: 18px 0 8px;

    color: var(--teal-dark);

    font-size: 12pt;

    text-transform: uppercase;
}

h3::before {
    content: "► ";

    color: var(--yellow);

    font-family:
        "Share Tech Mono",
        monospace;

    font-size: 9pt;
}


/* ------------------------------------------------------------
   H4–H6
   ------------------------------------------------------------ */

h4 {
    margin: 15px 0 6px;
    color: var(--teal-dark);
    font-size: 10.5pt;
}

h5,
h6 {
    margin: 12px 0 5px;
    color: var(--ink-soft);
    font-size: 10pt;
}


/* ============================================================
   08. SECTION BREAKS
   ============================================================ */

hr {
    height: 6px;

    margin: 24px 0;

    border: 0;
    /* Patrón de cinta de advertencia */
    background: repeating-linear-gradient(
        45deg,
        var(--ink) 0,
        var(--ink) 10px,
        var(--yellow) 10px,
