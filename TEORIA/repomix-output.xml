#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo "📂 Proyecto: $SCRIPT_DIR"
echo
echo "Selecciona la rama:"
