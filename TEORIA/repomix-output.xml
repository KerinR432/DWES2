/* ============================================================
   17. COVER / PORTADA
   ============================================================ */

/*
   IMPORTANT:
   The cover is designed around the printable A4 area rather
   than the full physical A4 page.

   With approximately 18–20 mm page margins, 255–260 mm
   is a safer vertical target than 230+ mm plus padding.
 */

.cover {
    display: flex;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
    background: var(--paper-light);
    color: var(--ink);
