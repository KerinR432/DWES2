/* ============================================================
   18. PAGE / SECTION BREAK STRATEGY
   ============================================================ */

/*
   Only major H1 sections start new pages.

   If your Markdown contains many H1 headings and you do NOT
   want every one to start a new page, remove this rule.
 */

h1:not(:first-of-type) {
    break-before: page;
    page-break-before: always;
}


/*
   Keep heading + following content together.
 */

h1 + p,
h1 + blockquote,
h1 + ul,
h1 + ol,
h1 + table,
h1 + pre,
h1 + .note,
h1 + .warning,
h1 + .danger,
h1 + .spec,
h1 + .machine,
h2 + p,
h2 + ul,
h2 + ol,
h2 + table,
h2 + pre,
h3 + p {
    break-before: avoid;
    page-break-before: avoid;
}


/* ============================================================
   19. WIDOW / ORPHAN CONTROL
   ------------------------------------------------------------
   Chromium's support is imperfect, but these are harmless
   fallbacks and improve engines that honor them.
   ============================================================ */

p {
    orphans: 3;
    widows: 3;
}


/* ============================================================
   20. HORIZONTAL OVERFLOW PROTECTION
   ============================================================ */

table,
pre,
img,
figure,
blockquote,
.note,
.warning,
.danger,
.dont-panic,
.machine,
.spec {
    max-width: 100%;
}


/* ============================================================
   21. PRINT-SPECIFIC CLEANUP
   ============================================================ */

@media print {

    html,
    body {
        margin: 0;
        padding: 0;

        background-color: var(--paper);

        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    /*
     * Prevent accidental URL decoration or browser artifacts.
     */
    a {
        color: inherit;
    }

    /*
     * Avoid interactive UI elements appearing in the PDF.
     */
    button,
    input,
    textarea,
    select {
        display: none !important;
    }

    /*
     * Decorative shadows are kept intentionally because they
     * are part of the graphic language.
     */
}


/* ============================================================
   22. SCREEN PREVIEW
   ------------------------------------------------------------
   Only affects the VS Code/browser preview.
   It does NOT alter the actual A4 PDF dimensions.
   ============================================================ */

@media screen {

    body {
        max-width: 850px;

        margin: 30px auto;
        padding: 40px;

        box-shadow:
            0 0 20px rgba(0, 0, 0, 0.15);
    }

    .cover {
        min-height: 1000px;
    }
}


/* ============================================================
   23. OPTIONAL UTILITY CLASSES
   ============================================================ */

/*
