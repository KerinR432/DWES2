    font-family: "IBM Plex Mono", monospace;
    font-size: 10pt;
    letter-spacing: 0.1em;
}

/* ============================================================
   MAGIA 2026: EXPERIENCIA EN PANTALLA VS CODE (Se omite en PDF)
